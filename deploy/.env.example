# Copy to deploy/.env and edit. Never commit the real .env.

# Your audiobook folder on the host (mounted at /library).
SIMPLEAPB_LIBRARY=/srv/audiobooks

# How phones reach ntfy through your reverse proxy (TLS), e.g. https://push.example.com
NTFY_PUBLIC_URL=https://push.example.com

# The reverse proxy's IP or subnet (comma-separated), so real client IPs are used.
SIMPLEAPB_TRUSTED_PROXIES=

# Only with the "postgres" profile.
POSTGRES_PASSWORD=change-me

# The server version to run: a release such as 0.5.0 (recommended; the updater
# keeps it current), or "latest".
SIMPLEAPB_VERSION=latest

# Only for one-click updates (docker compose --profile updater up -d): this
# folder's absolute path, e.g. /opt/simpleapb/deploy.
# SIMPLEAPB_DEPLOY_DIR=

# Optional
# SIMPLEAPB_PORT=8080
# NTFY_PORT=8081
# SIMPLEAPB_CONFIG=./data/config
# SIMPLEAPB_CACHE=./data/cache
# SIMPLEAPB_BACKUPS=./data/backups
# SIMPLEAPB_MEMORY_LIMIT=2g
# TZ=UTC

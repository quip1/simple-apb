{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple APB",
  "version": "0.6.0",
  "identifier": "org.simpleapb.desktop",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Simple APB",
    "category": "Music",
    "shortDescription": "Audiobooks from your own server",
    "copyright": "AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCRjkzODNCQkEzNkIwQTEKUldTaHNEYTZPemo1aXlRd015V3JxKzZRMExMeTcrZUJ1amNqZlphYURuVVRGd0RDZ2ZiV2J6M0cK",
      "endpoints": [
        "https://github.com/quip1/simple-apb/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

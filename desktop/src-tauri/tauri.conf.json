{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple APB",
  "version": "0.5.1",
  "identifier": "org.simpleapb.desktop",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Simple APB",
    "category": "Music",
    "shortDescription": "Audiobooks from your own server",
    "copyright": "AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}

<!-- The sideloaded build updates itself (ADR-0052): it installs the release's
     APK through Android's package installer. The play and fdroid builds get
     updates from their stores and have neither of these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>

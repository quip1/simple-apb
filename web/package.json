{
  "name": "@simple-apb/web",
  "private": true,
  "version": "0.5.3",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../server/openapi.yaml -o src/api/schema.gen.ts",
    "gen:docs": "node scripts/gen-api-docs.mjs ../server/openapi.yaml ../docs/API.md",
    "lint:api": "redocly lint --config redocly.yaml ../server/openapi.yaml",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "dev": "vite",
    "build": "vite build",
    "build:embed": "vite build && node scripts/embed.mjs",
    "build:desktop": "vite build --mode desktop --outDir dist-desktop",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\" playwright.config.ts",
    "lint": "eslint .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "hls.js": "^1.6.15",
    "intl-messageformat": "^12.1.4",
    "openapi-fetch": "^0.14.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.0",
    "@redocly/cli": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.6",
    "yaml": "^2.8.0"
  }
}

{
  "name": "@simple-apb/web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../server/openapi.yaml -o src/api/schema.gen.ts",
    "gen:docs": "node scripts/gen-api-docs.mjs ../server/openapi.yaml ../docs/API.md",
    "lint:api": "redocly lint --config redocly.yaml ../server/openapi.yaml",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "dev": "vite",
    "build": "vite build",
    "build:embed": "vite build && node scripts/embed.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\""
  },
  "dependencies": {
    "intl-messageformat": "^12.1.4",
    "openapi-fetch": "^0.14.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/qrcode": "^1.5.6",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "yaml": "^2.8.0"
  }
}
